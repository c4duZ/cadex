            "fontSize": "sheetTitle",
            "weight": "semibold"
          },
          "rowGap": 10,
          "columnGap": 12
        },
        "foot": {
          "paddingTop": 10,
          "border": "line.subtle",
          "fontSize": "small",
          "color": "text.tertiary",
          "gap": 12
        }
      },
      "tabs": {
        "bg": "bg.card",
        "border": "line.default",
        "radius": "item",
        "padding": 3,
        "gap": 2,
        "tab": {
          "height": 26,
          "padding": "0 12",
          "radius": "control",
          "fontSize": "panel",
          "weight": "medium",
          "color": "text.muted"
        },
        "on": {
          "bg": "bg.segment",
          "color": "text.primary",
          "weight": "semibold"
        }
      },
      "box": {
        "padding": "12 14",
        "radius": "pane",
        "bg": "bg.sidebar",
        "border": "line.subtle",
        "row": {
          "padding": "9 0",
          "gap": 16,
          "divider": "line.subtle",
          "name": "text.row",
          "value": "text.secondary",
          "nameWidth": 180
        }
      },
      "label": {
        "fontSize": "caption",
        "weight": "semibold",
        "tracking": "label",
        "color": "text.tertiary"
      },
      "chip": {
        "padding": "2 7",
        "radius": "chip",
        "fontSize": "chip",
        "weight": "semibold",
        "gap": 5,
        "dot": 6,
        "neutral": {
          "bg": "bg.chip",
          "color": "text.secondary"
        },
        "green": {
          "bg": "chip.prBg",
          "color": "chip.prText",
          "dot": "state.done"
        },
        "amber": {
          "bg": "chip.usageBg",
          "color": "accent.amberText",
          "dot": "state.needs"
        },
        "agent": {
          "bg": "bg.chip",
          "color": "state.review"
        },
        "closed": {
          "dot": "state.idle"
        }
      },
      "field": {
        "height": 30,
        "width": 200,
        "padding": "0 10",
        "radius": "control",
        "bg": "bg.inset",
        "border": "line.default",
        "placeholder": "text.tertiary",
        "fontSize": "panel",
        "focus": {
          "border": "line.focus",
          "shadow": "haloInput"
        }
      },
      "section": {
        "about": "'Seus projetos' and its count over the project cards (MemoryOverview).",
        "fontSize": "sheetTitle",
        "weight": "semibold",
        "gap": 10,
        "marginTop": 8
      },
      "popup": {
        "height": 30,
        "padding": "0 10",
        "gap": 8,
        "radius": "control",
        "bg": "bg.button",
        "border": "line.control",
        "fontSize": "panel",
        "caret": {
          "fontSize": "caption",
          "color": "text.secondary"
        }
      },
      "link": {
        "color": "accent.link",
        "weight": "medium"
      },
      "table": {
        "header": {
          "padding": "8 12",
          "fontSize": "caption",
          "weight": "semibold",
          "color": "text.tertiary",
          "border": "line.subtle"
        },
        "row": {
          "padding": "9 12",
          "fontSize": "panel",
          "color": "text.row",
          "border": "line.subtle",
          "hover": "bg.raised"
        },
        "columnGap": 12
      },
      "notice": {
        "padding": "10 14",
        "radius": "pane",
        "bg": "tint.needs",
        "border": "line.amber",
        "title": "accent.amberText",
        "text": "text.amberNote",
        "dot": "state.needs"
      },
      "ok": {
        "color": "accent.greenText",
        "dot": "state.done"
      },
      "mono": {
        "fontSize": "meta",
        "lineHeight": "relaxed"
      },
      "diff": {
        "radius": "row",
        "border": "line.subtle",
        "fontSize": "meta",
        "lineHeight": "terminal",
        "padding": "0 12",
        "hunk": {
          "bg": "bg.inset",
          "color": "text.tertiary",
          "padding": "2 12"
        },
        "add": {
          "bg": "diff.addBg",
          "color": "diff.addText"
        },
        "del": {
          "bg": "diff.delBg",
          "color": "diff.delText"
        }
      },
      "radio": {
        "size": 12,
        "off": "line.control",
        "on": "state.working"
      },
      "event": {
        "padding": "10 14",
        "radius": "row",
        "bg": "bg.sidebar",
        "border": "line.subtle",
        "gap": 6,
        "listGap": 8,
        "number": {
          "fontSize": "small",
          "color": "text.tertiary"
        },
        "body": {
          "fontSize": "meta",
          "lineHeight": "relaxed",
          "color": "text.body"
        }
      },
      "pager": {
        "fontSize": "meta",
        "color": "text.tertiary",
        "current": "text.row",
        "gap": 12,
        "slider": {
          "width": 140,
          "track": "line.control",
          "knob": "state.working",
          "knobSize": 12
        }
      },
      "graph": {
        "size": 600,
        "radius": "pane",
        "bg": "bg.inset",
        "border": "line.subtle",
        "ringRadius": 250,
        "node": {
          "size": 10,
          "color": "accent.greenText",
          "opacity": "paneIdle",
          "hover": "haloChosen"
        },
        "tip": {
          "padding": "6 10",
          "radius": "control",
          "bg": "bg.raised",
          "border": "line.popover",
          "shadow": "popover"
        }
      },
      "search": {
        "hit": {
          "bg": "chip.usageBg",
          "color": "accent.amberText",
          "radius": "line",
          "padding": "0 2",
          "inTitle": true
        },
        "result": {
          "padding": "10 0",
          "gap": 4,
          "divider": "line.subtle",
          "snippet": "text.body"
        }
      },
      "empty": {
        "gap": 6,
        "title": {
          "fontSize": "sheetTitle",
          "weight": "semibold"
        },
        "text": {
          "fontSize": "meta",
          "color": "text.muted"
        }
      },
      "markdown": {
        "fontSize": "prompt",
        "lineHeight": "terminal",
        "color": "text.body",
        "gap": 8
      },
      "aside": {
        "width": 220,
        "paddingTop": 36
      },
      "help": {
        "glyph": "text.tertiary",
        "popover": {
          "padding": "6 10",
          "radius": "control",
          "bg": "bg.raised",
          "border": "line.popover",
          "shadow": "popover"
        }
      }
    }
  }
}
